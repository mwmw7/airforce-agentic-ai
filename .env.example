# ──────────────────────────────────────────────────────────────
#  공군 Agentic AI 교육 · 환경 변수
#  이 파일을 .env 로 복사한 뒤 강사가 나눠준 토큰을 채우세요.
#  (키가 하나도 없어도 LLM_MODE=mock · JEV_MODE=local · MEMORY_MODE=file · SEARCH_MODE=mock 으로 모든 실습이 돌아갑니다)
# ──────────────────────────────────────────────────────────────

# ① LLM (보고서 작성 담당) — OpenAI 호환 주소라면 무엇이든 OK
#    relay  : 강사가 AWS Bedrock 에 올려 둔 보고서용 모델 (기본. 주소와 조별 토큰만 붙이면 됨)
#    ollama : 내 노트북의 Ollama (ollama pull qwen3:8b) — 선택
#    cloud  : 워크숍 당일 배포되는 클라우드 키 — 선택
#    mock   : 네트워크 없이 흐름만 확인 (정해진 답)
LLM_MODE=mock
LLM_BASE_URL=https://relay.example.mil/v1
LLM_API_KEY=team-token-here
# 늦으면 끊기: 한 번 호출은 LLM_TIMEOUT_SEC 초, 실행 전체는 RUN_TIMEOUT_SEC 초 (실습 0). 늦으면 사람에게 묻는다
LLM_TIMEOUT_SEC=60
RUN_TIMEOUT_SEC=180
LLM_MODEL=qwen3-32b

# Ollama 로 바꿀 때 예시
# LLM_MODE=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# ①-b 웹 검색
#    mock   : data/web/search-results.json 의 가상 결과 (기본)
#    tavily : 실제 웹 검색 (강사가 나눠주는 TAVILY_API_KEY 필요)
SEARCH_MODE=mock
TAVILY_API_KEY=

# ② Jev 판정 모델 (TypeSafe System One) — OpenRouter Decisions API 경유
#    openrouter : 강사 측 키 사용
#    local      : 규칙 기반 로컬 판정기 (네트워크 불필요)
JEV_MODE=local
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# ③ 장기 메모리 (Hindsight)
#    hindsight : docker 로 띄운 Hindsight 서버 (http://localhost:8888)
#    file      : .hindsight/ 폴더에 JSON 으로 저장 (네트워크 불필요)
MEMORY_MODE=file
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK=scramble

# ④ 트레이싱 — 기본은 traces/*.jsonl 로컬 파일. [강의 5] 에서 Langfuse 로 확장
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ⑤ Harness 상한
MAX_STEPS=8

# ⑥ LangSmith (선택) — 트레이싱 + LangGraph Studio(pnpm studio). smith.langchain.com 무료 가입 후 키 발급. 없으면 loop:live 를 쓰면 된다
#    LANGSMITH_TRACING=true 로 켜면 실행마다 노드 → LLM 호출·Jev·기억·MCP 호출이 트리로 올라간다 (코드 수정 없음, 끄면 traces/*.jsonl 만 남는다)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airforce-agentic-ai
