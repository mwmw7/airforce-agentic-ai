# ──────────────────────────────────────────────────────────────
#  공군 Agentic AI 교육 · 환경 변수
#  1) pnpm setup:check 가 이 파일을 .env 로 복사해 줍니다 ← 그 상태 그대로 전부 돌아갑니다 (mock · local · file, 키 없음)
#  2) 교육 당일 강사가 조별 OpenRouter 키를 나눠주면 아래 "당일 바꿀 줄" 만 고칩니다 (키 하나로 LLM 과 Jev 둘 다)
# ──────────────────────────────────────────────────────────────
#  [당일 바꿀 줄]
#    LLM_MODE=cloud  · LLM_BASE_URL=https://openrouter.ai/api/v1 · LLM_API_KEY=<조별 키> · LLM_MODEL=<당일 안내>   (① 모델)
#    JEV_MODE=openrouter · OPENROUTER_API_KEY=<같은 조별 키>                                                        (② Jev 판정)
#    나머지(MCP·기억·트레이싱)는 그대로 둬도 됩니다
# ──────────────────────────────────────────────────────────────

# ① LLM (도구를 고르고 사실을 정리하는 모델) — OpenAI 호환 주소라면 무엇이든 OK
#    cloud  : OpenRouter — 키 하나로 프런티어(Claude·GPT·Gemini)와 오픈 모델(Qwen 등)을 이름만 바꿔 쓴다 (당일 사용, 아래 예시)
#    ollama : 내 노트북의 Ollama (ollama pull qwen3:8b) — 선택
#    relay  : 자체 중계 서버(vLLM 등 OpenAI 호환 주소) — 폐쇄망으로 옮길 때
#    mock   : 네트워크 없이 흐름만 확인 (정해진 답)
LLM_MODE=mock
# 당일: 아래 두 줄을 OpenRouter 예시(cloud)처럼 바꿉니다 (지금은 자리표시)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=team-key-here
# 늦으면 끊기: 한 번 호출은 LLM_TIMEOUT_SEC 초, 실행 전체는 RUN_TIMEOUT_SEC 초. 늦으면 사람에게 묻는다
LLM_TIMEOUT_SEC=60
RUN_TIMEOUT_SEC=180
LLM_MODEL=qwen3-32b
# 한 번 답의 최대 길이. 중계 서비스는 이 값만큼 요금을 미리 잡아 두므로 너무 크면 잔액 부족(402)이 난다
LLM_MAX_TOKENS=4096

# 당일 OpenRouter 설정 (조별 키는 강사가 배포. 키마다 지출 상한이 걸려 있다)
# LLM_MODE=cloud
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=anthropic/claude-sonnet-5.5      # 비교용 오픈 모델: qwen/qwen3-32b

# Ollama 로 바꿀 때 예시
# LLM_MODE=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# ② Jev 판정 모델 (TypeSafe System One)
#    typesafe   : TypeSafe 공식 SDK, 강사가 나눠주는 TYPESAFE_API_KEY (권장)
#    openrouter : OpenRouter Decisions API 경유 (OPENROUTER_API_KEY = LLM 과 같은 OpenRouter 키, JEV_MODEL=typesafe/jev-1.13)
#    local      : 규칙 기반 로컬 판정기 (네트워크 불필요)
JEV_MODE=local
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# ③ 날씨 MCP 서버 주소 — 다른 터미널에서 pnpm mcp:weather 로 먼저 켠다 (agent 가 자동으로 켜지 않는다)
MCP_WEATHER_URL=http://localhost:3333/mcp

# ④ 장기 기억 (Hindsight)
#    file      : .hindsight/<bank>.json 에 저장 (서버 없음, 기본값)
#    hindsight : Hindsight 서버. pnpm memory:up 으로 내 노트북에 띄우거나(uv 필요) 강사 서버 주소를 적는다
#    off       : 기억 없음 (찾지도 남기지도 않는다) — 기억 있는 Agent 와 없는 Agent 를 비교할 때
MEMORY_MODE=file
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK=control-room
# Hindsight 가 기억을 정리할 때 쓸 모델 (비우면 LLM_MODEL). Ollama 는 기본 문맥이 4096 토큰이라 정리 단계가 넘친다 → 16K 판을 만들어 쓴다:
#   printf 'FROM qwen3:4b-instruct-2507-q4_K_M\nPARAMETER num_ctx 16384\n' > Modelfile && ollama create qwen3-4b-instruct-16k -f Modelfile
#   (Agent 의 LLM_MODEL 도 같은 모델로 두면 GPU 에서 두 모델을 번갈아 올리지 않아 빠르다)
# 기억 정리용 LLM 을 따로 쓰고 싶을 때 (작은 모델이 빠르다. ollama pull qwen3:4b). 비우면 LLM_MODEL 과 같은 모델. MEMORY_MODE=file 이면 안 쓴다
# HINDSIGHT_LLM_MODEL=qwen3:4b
# OpenRouter 를 쓸 때는 싼 모델로: HINDSIGHT_LLM_MODEL=anthropic/claude-haiku-4.5 (또는 qwen/qwen3-32b)
#   주의: claude-*-5.5 는 안 된다. Hindsight 는 temperature + JSON 형식 + "모든 파라미터 지원하는 곳만"(require_parameters)을
#         함께 보내는데, OpenRouter 의 5.5 엔드포인트는 temperature 를 지원 목록에 안 올려 404(No endpoints found)가 난다 → 기억이 안 쌓인다

# ⑤ 트레이싱 — 기본은 traces/*.jsonl 로컬 파일. Langfuse 특강에서 확장
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ⑥ Harness 상한 (모델을 최대 몇 번까지 부를지)
MAX_STEPS=8

# ⑦ LangSmith (선택) — 트레이싱 + LangGraph Studio(pnpm see:studio). smith.langchain.com 무료 가입 후 키 발급. 없으면 pnpm see:run 를 쓰면 된다
#    LANGSMITH_TRACING=true 로 켜면 실행마다 노드 → LLM 호출·Jev 판정이 트리로 올라간다 (코드 수정 없음, 끄면 traces/*.jsonl 만 남는다)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airforce-agentic-ai
