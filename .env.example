# ──────────────────────────────────────────────────────────────
#  공군 Agentic AI 교육 · 환경 변수
#  이 파일을 .env 로 복사한 뒤 강사가 나눠준 토큰을 채우세요.
#  (키가 하나도 없어도 LLM_MODE=mock / JEV_MODE=local 로 모든 실습이 돌아갑니다)
# ──────────────────────────────────────────────────────────────

# ① 메인 LLM (조사·설명 담당) — OpenAI 호환 엔드포인트라면 무엇이든 OK
#    relay  : 강사 측 Bedrock 중계 API (기본값, 조별 토큰 배포)
#    ollama : 내 노트북의 Ollama (ollama pull qwen3:8b)
#    cloud  : 워크숍 당일 배포되는 클라우드 키
#    mock   : 네트워크 없이 그래프 흐름만 확인 (규칙 기반 응답)
LLM_MODE=mock
LLM_BASE_URL=https://relay.example.mil/v1
LLM_API_KEY=team-token-here
LLM_MODEL=qwen3-32b

# Ollama 로 바꿀 때 예시
# LLM_MODE=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# ② Jev 판정 모델 (TypeSafe System One) — OpenRouter Decisions API 경유
#    openrouter : 강사 측 키 사용
#    local      : 규칙 기반 로컬 판정기 (네트워크 불필요)
JEV_MODE=local
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# ③ 장기 메모리 (Hindsight)
#    hindsight : docker 로 띄운 Hindsight 서버 (http://localhost:8888)
#    file      : .hindsight/ 폴더에 JSON 으로 저장 (네트워크 불필요)
MEMORY_MODE=file
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK=scramble

# ④ 트레이싱 — 기본은 traces/*.jsonl 로컬 파일. [강의 5] 에서 Langfuse 로 확장
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ⑤ Harness 상한
MAX_STEPS=8
