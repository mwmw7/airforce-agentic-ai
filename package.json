{
  "name": "airforce-agentic-ai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "description": "공군 AI센터 Agentic AI 교육 (2026.10.29~30) 핸즈온 저장소 — TypeScript · LangGraph.js · Jev",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node tools/require-pnpm.mjs",
    "setup:check": "tsx tools/doctor.ts",
    "typecheck": "tsc --noEmit",
    "agent": "tsx labs/agent/main.ts",
    "agent:limit": "MAX_STEPS=1 tsx labs/agent/main.ts",
    "step": "node tools/step.mjs",
    "mcp:weather": "tsx mcp-servers/weather/server.ts",
    "mcp:inspect": "pnpm dlx @modelcontextprotocol/inspector",
    "memory:up": "tsx tools/memory-up.ts",
    "memory:reset": "tsx tools/memory-reset.ts",
    "memory:ui": "uvx hindsight-embed -p airforce-agent ui start --port 18888",
    "memory:ui:stop": "uvx hindsight-embed -p airforce-agent ui stop --port 18888",
    "see:run": "tsx labs/agent/main.ts --live",
    "see:graph": "tsx tools/draw-graph.ts",
    "see:steps": "node tools/draw-steps.mjs",
    "see:studio": "node tools/see-studio.mjs",
    "instructor:make-handson": "node tools/make-handson.mjs",
    "slides": "python3 tools/make-slides.py",
    "slides:pdf": "node tools/make-slides-pdf.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vectorize-io/hindsight-all": "^0.10.2",
    "@vectorize-io/hindsight-client": "^0.10.2",
    "dotenv": "^16.4.0",
    "langsmith": "0.10.5",
    "openai": "^4.100.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.5.1",
    "@types/node": "^22.0.0",
    "playwright-core": "1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
